# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
version: "0.1.0"
synopsis:
  "Eio-native observability handle: tracing, structured logging, and metrics"
description: """
A small Eio-native observability event model — distributed tracing (W3C traceparent),
structured logging, and metrics (counter/gauge/histogram) behind a single
capability-passed handle, with pluggable backends. Not a replacement for every OCaml
observability package: it is a compact core that backend packages such as
obs-loki-eio and obs-prometheus-eio adapt to real exporters."""
maintainer: ["lbendtlynielsen@gmail.com"]
authors: ["lbendtly"]
license: "MIT"
homepage: "https://github.com/loganbnielsen/obs-eio"
bug-reports: "https://github.com/loganbnielsen/obs-eio/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml" {>= "5.4.0"}
  "eio" {>= "1.3"}
  "mtime" {>= "2.1.0"}
  "eio_main" {>= "1.3" & with-test}
  "alcotest" {with-test}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/loganbnielsen/obs-eio.git"
